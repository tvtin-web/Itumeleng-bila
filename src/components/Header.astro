---
const path = Astro.url.pathname;
const isHome = path === '/';
const isServices = path.startsWith('/services');
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand">
      <span class="mark">Y</span>
      <span class="brand-text">
        <span class="brand-name">YETS</span>
        <span class="brand-sub">Youth Empowerment Training Solutions</span>
      </span>
    </a>
    <nav aria-label="Main">
      <a href="/" class:list={['link', { active: isHome }]} aria-current={isHome ? 'page' : undefined}>Home</a>
      <a href="/services" class:list={['link', { active: isServices }]} aria-current={isServices ? 'page' : undefined}>Services</a>
      <a href="/#about" class="link">About</a>
      <a href="#contact" class="link">Contact</a>
      <a href="#contact" class="book">Book a training</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--cream);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    padding: 18px 32px;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--ink);
  }
  .brand:hover {
    color: var(--ink);
  }
  .mark {
    width: 44px;
    height: 44px;
    border-radius: 12px;
    background: var(--green-700);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
  }
  .brand-text {
    display: flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .brand-name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.04em;
  }
  .brand-sub {
    font-size: 12px;
    color: var(--ink-muted);
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
  }
  .link {
    color: var(--ink);
    font-weight: 500;
    text-decoration: none;
    padding: 10px 0;
  }
  .link:hover {
    color: var(--green-700);
  }
  .link.active {
    color: var(--green-700);
    font-weight: 700;
  }
  .book {
    background: var(--green-700);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
    padding: 12px 22px;
    border-radius: 999px;
  }
  .book:hover {
    color: #fff;
    background: var(--green-800);
  }

  @media (max-width: 640px) {
    .bar {
      padding: 14px 20px;
    }
    nav {
      gap: 8px 20px;
    }
  }
</style>
